{
  "name": "Nimbus - Python Tkinter Desktop",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "vscode",
      "webPort": "6080",
      "vncPort": "5901"
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y python3 python3-tk python3-venv",
  "forwardPorts": [
    6080,
    8765
  ],
  "portsAttributes": {
    "6080": {
      "label": "Nimbus Desktop (noVNC)",
      "onAutoForward": "openBrowser"
    },
    "8765": {
      "label": "Nimbus - Enviar CSV do computador",
      "onAutoForward": "notify"
    }
  },
  "runArgs": [
    "--shm-size=1g"
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3"
      },
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
